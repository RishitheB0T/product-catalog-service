<?xml version="1.0" encoding="UTF-8"?>
<!--
	BUILD FLOW 02.01 — backend/pom.xml
	First introduced: Phase 02
	Purpose: Maven's description of the backend: who the project is, which Spring Boot version
	         it builds on, which Java version it targets, which libraries it uses, and how the
	         runnable jar is packaged.
	Depends on: The Maven Wrapper (02.02 to 02.04), which supplies Maven 3.10.0, and Maven
	            Central, where the libraries are downloaded from.
	Used by: .\mvnw.cmd test, verify and spring-boot:run on this laptop; from Phase 14 also CI
	         and the backend Docker image build.
	Runtime role: None at runtime. It decides what goes inside the application jar.

	POM means Project Object Model. Maven reads it in this order: identity (coordinates),
	inheritance (parent), settings (properties), libraries (dependencies), build steps (plugins).
	Generated by Spring Initializr on 2026-10-20; comments and project links were added by hand.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- BUILD FLOW 02.01.01 — Parent: inherit Spring Boot's tested defaults
	     spring-boot-starter-parent 4.1.1 gives us two things:
	     1. Dependency management (a "bill of materials"): one tested version for each of
	        hundreds of libraries. That is why the dependencies below have no version tags.
	        Spring Boot 4.1.1 picks them, for example Spring Framework 7.0.9 and Jackson 3.1.5.
	     2. Plugin defaults: UTF-8 source encoding, the compiler flag that keeps method
	        parameter names, and the setup for the spring-boot-maven-plugin at the bottom.
	     Upgrading Spring Boot later means changing this one version, and every library moves
	     together to a combination the Spring team has tested. -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<!-- Empty relativePath: fetch the parent from Maven Central, not from a parent folder. -->
		<relativePath/>
	</parent>

	<!-- BUILD FLOW 02.01.02 — Coordinates: this project's identity
	     groupId, artifactId and version name the built file: target/catalog-0.0.1-SNAPSHOT.jar.
	     SNAPSHOT marks our own unreleased, in-development version. The plan's "no snapshots"
	     rule is about the libraries we depend on, not about our own code.
	     com.example is used because example.com is reserved for documentation, so the name
	     never claims a domain we don't own (decision D-010). -->
	<groupId>com.example</groupId>
	<artifactId>catalog</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>catalog</name>
	<description>Product catalog service</description>

	<!-- BUILD FLOW 02.01.03 — Project links
	     url and scm (source control) point at our GitHub repository. The empty licenses and
	     developers elements are deliberate: without them, Maven would inherit the Spring Boot
	     project's own license and developer list from the parent POM, which are not ours. -->
	<url>https://github.com/RishitheB0T/product-catalog-service</url>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection>scm:git:https://github.com/RishitheB0T/product-catalog-service.git</connection>
		<developerConnection>scm:git:https://github.com/RishitheB0T/product-catalog-service.git</developerConnection>
		<tag>HEAD</tag>
		<url>https://github.com/RishitheB0T/product-catalog-service</url>
	</scm>

	<!-- BUILD FLOW 02.01.04 — Properties: values the parent and plugins read
	     java.version 21 makes the compiler produce Java 21 bytecode and accept only the Java 21
	     API, so the jar runs on any Java 21 or newer runtime, including the eclipse-temurin 21
	     image planned for Phase 14. -->
	<properties>
		<java.version>21</java.version>
	</properties>

	<!-- BUILD FLOW 02.01.05 — Dependencies: only what Phase 02 needs (decision D-004)
	     A starter is one dependency that brings a library plus Spring Boot's auto-configuration
	     for it. Database starters arrive in Phase 04 and Redis in Phase 09, so today the
	     application starts without any other service running. -->
	<dependencies>
		<!-- Operational endpoints such as /actuator/health. What is exposed over HTTP is
		     restricted in application.yml (02.06). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- Bean Validation (Hibernate Validator): annotations such as @NotBlank and @Size that
		     check incoming data. First used on the request DTOs in Phase 05. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!-- Spring MVC, the embedded Tomcat web server, and Jackson 3 for JSON. Spring Boot 4
		     renamed the older spring-boot-starter-web to spring-boot-starter-webmvc. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!-- BUILD FLOW 02.01.08 — Persistence (added in Phase 04)
		     spring-boot-starter-data-jpa: JPA with Hibernate 7 as the implementation, Spring Data
		     repositories, the HikariCP connection pool, and Spring's transaction support.
		     spring-boot-starter-flyway: runs the versioned SQL migrations at startup, before Hibernate
		     checks the schema. Versions come from the Spring Boot parent (Flyway 12.4.0). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<!-- Flyway's MySQL support is a separate module. Without it, Flyway refuses to work with MySQL. -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-mysql</artifactId>
		</dependency>
		<!-- The JDBC driver (Connector/J 9.7.0). Scope "runtime": our code never imports it; HikariCP
		     and Hibernate load it, so it is left off the compile classpath. -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- BUILD FLOW 02.01.06 — Test-only dependencies
		     Scope "test" puts these on the test classpath only; they never ship inside the jar.
		     Spring Boot 4 has one test starter per technology. Together they bring JUnit 6,
		     AssertJ, Mockito, and Spring's test support such as @SpringBootTest. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- BUILD FLOW 02.01.09 — Persistence test support (added in Phase 04)
		     The JPA and Flyway test starters provide the @DataJpaTest slice (only the persistence
		     beans, each test rolled back). spring-boot-testcontainers and testcontainers-mysql start a
		     real MySQL 8.4 in Docker for the tests and hand its address to Spring (@ServiceConnection),
		     so tests exercise the same database engine as development and production. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-mysql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<!-- BUILD FLOW 02.01.07 — Build: one runnable jar
	     spring-boot-maven-plugin repackages target/catalog-0.0.1-SNAPSHOT.jar into an executable
	     "fat jar" that contains our classes plus every runtime library, started with java -jar.
	     It also provides the spring-boot:run goal used for local development. -->
	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
