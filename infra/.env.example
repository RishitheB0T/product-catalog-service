# BUILD FLOW 03.02 — infra/.env.example
# First introduced: Phase 03
# Purpose: Template for infra/.env, the private settings file Docker Compose reads for the development
#          services. It lists every setting with a placeholder and contains no real secret.
# Depends on: Nothing.
# Used by: scripts/dev-services.ps1 (03.03), which copies it to infra/.env on the first "up" and replaces
#          each "generate-me" value with a new random password. infra/.env itself is git-ignored.
# Runtime role: docker compose reads infra/.env to fill in the ${...} values in infra/compose.dev.yaml.
#
# Format: KEY=value, one setting per line, no quotes and no spaces around "=". Lines starting with # are comments.

# BUILD FLOW 03.02.01 — MySQL database and accounts
MYSQL_DATABASE=catalog
MYSQL_USER=catalog
MYSQL_PASSWORD=generate-me
MYSQL_ROOT_PASSWORD=generate-me

# BUILD FLOW 03.02.02 — Host ports (this project's 24xxx block; see README "Ports")
MYSQL_HOST_PORT=24306
REDIS_HOST_PORT=24379
